[Unit]
Description=Ongi PostgreSQL
StartLimitIntervalSec=120
StartLimitBurst=10

[Container]
StopTimeout=60
Image=docker.io/library/postgres:17.11-alpine
ContainerName=ongi-db
Network=ongi.network
NetworkAlias=database
EnvironmentFile=@HOME@/secrets/db.env
Volume=ongi-db.volume:/var/lib/postgresql/data
LogDriver=k8s-file
LogOpt=max-size=20mb
HealthCmd=pg_isready -U table_order -d table_order
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3

[Service]
TimeoutStopSec=70
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60
MemoryMax=3G

[Install]
WantedBy=multi-user.target
