[Unit]
Description=Ongi HTTPS and web apps
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Container]
StopTimeout=35
Image=docker.io/library/caddy:2.11.4-alpine
ContainerName=ongi-caddy
Network=ongi.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=@HOME@/web:/srv:ro,z
Volume=@HOME@/caddy:/etc/caddy:ro,z
Volume=ongi-caddy-data.volume:/data
Volume=ongi-caddy-config.volume:/config
EnvironmentFile=@HOME@/caddy/environment
LogDriver=k8s-file
LogOpt=max-size=20mb

[Service]
Restart=always
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=45
MemoryMax=512M

[Install]
WantedBy=multi-user.target
