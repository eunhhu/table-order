{
  "name": "table-order",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:dev": "bun scripts/setup-dev.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:admin": "bun --cwd apps/admin dev",
    "dev:customer": "bun --cwd apps/customer dev",
    "build": "bun --cwd apps/admin build && bun --cwd apps/customer build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests/unit",
    "test:integration": "bun scripts/test.ts tests/integration",
    "test:db": "bun scripts/test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "check": "bun run lint && bun run typecheck && bun scripts/test.ts tests/unit tests/integration && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@table/contracts": "workspace:*",
    "@table/db": "workspace:*",
    "@table/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "lucide-solid": "1.43.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
    "solid-js": "1.9.15",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/cli": "0.1.19",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.10",
    "jsqr": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
